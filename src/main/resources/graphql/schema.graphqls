type Query {
    me: User!
    hotel(id: ID!): Hotel
    searchHotels(input: SearchInput!): [RoomOffer!]!
    quoteStay(input: QuoteInput!): Quote!
    myBookings: [Booking!]!
    booking(id: ID!): Booking
    myNotifications: [Notification!]!
    occupancyAndRevenue(input: PeriodInput!): OccupancyRevenue!
}

input SearchInput {
    city: String!
    checkIn: String!
    checkOut: String!
    guests: Int!
}

input QuoteInput {
    roomId: ID!
    checkIn: String!
    checkOut: String!
    guests: Int!
}

input PeriodInput {
    hotelId: ID!
    from: String!
    to: String!
}

type User {
    id: ID!
    email: String!
    fullName: String!
    phone: String
    roles: [String!]!
}

type Hotel {
    id: ID!
    name: String!
    city: String!
    address: String
    starRating: Float!
}

type RoomOffer {
    roomId: ID!
    hotel: Hotel!
    roomType: String!
    capacity: Int!
    basePrice: Float!
    nightlyPrice: Float!
    available: Boolean!
}

type Quote {
    roomId: ID!
    checkIn: String!
    checkOut: String!
    guests: Int!
    basePrice: Float!
    total: Float!
    multipliers: Multipliers!
    explanation: String!
}

type Multipliers {
    occupancy: Float!
    season: Float!
    weekday: Float!
    demand: Float!
    guest: Float!
}

type Booking {
    id: ID!
    roomId: ID!
    hotelId: ID!
    checkIn: String!
    checkOut: String!
    guests: Int!
    status: String!
    totalPrice: Float!
    holdUntil: String
    snapshot: PriceSnapshot
}

type PriceSnapshot {
    basePrice: Float!
    occupancyMultiplier: Float!
    seasonMultiplier: Float!
    weekdayMultiplier: Float!
    demandMultiplier: Float!
    guestMultiplier: Float!
    calculatedPrice: Float!
}

type Notification {
    id: ID!
    kind: String!
    body: String!
    status: String!
    createdAt: String!
}

type OccupancyRevenue {
    hotelId: ID!
    occupancy: Float!
    revenue: Float!
    periodFrom: String!
    periodTo: String!
}
